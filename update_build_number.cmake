if(EXISTS "${ENGINE_INFO_FILE}")
    file(READ "${ENGINE_INFO_FILE}" ENGINE_INFO_CONTENT)
    string(REGEX MATCH "#define ENGINE_BUILD_NUMBER ([0-9]+)" _match "${ENGINE_INFO_CONTENT}")
    if(_match)
        string(REGEX REPLACE ".*#define ENGINE_BUILD_NUMBER ([0-9]+).*" "\\1" CURRENT_BUILD_NUMBER "${ENGINE_INFO_CONTENT}")
        math(EXPR NEW_BUILD_NUMBER "${CURRENT_BUILD_NUMBER} + 1")
    else()
        set(NEW_BUILD_NUMBER 1)
    endif()
else()
    set(NEW_BUILD_NUMBER 1)
endif()

string(TIMESTAMP BUILD_DATE "%Y-%m-%d %H:%M:%S")

file(WRITE "${ENGINE_INFO_FILE}" "#pragma once\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_VERSION_MAJOR ${PROJECT_VERSION_MAJOR}\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_VERSION_MINOR ${PROJECT_VERSION_MINOR}\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_VERSION_PATCH ${PROJECT_VERSION_PATCH}\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_BUILD_NUMBER ${NEW_BUILD_NUMBER}\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_BUILD_DATE \"${BUILD_DATE}\"\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_BUILD_TYPE \"${CMAKE_BUILD_TYPE}\"\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_VERSION_STR \"${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}\"\n")
file(APPEND "${ENGINE_INFO_FILE}" "#define ENGINE_VERSION_FULL_STR \"${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}.${NEW_BUILD_NUMBER}\"\n")

message(STATUS "Build number updated to: ${NEW_BUILD_NUMBER}")